{
  "name": "keepcloud/vultr-api-laravel",
  "description": "Laravel package for Vultr V2 Api",
  "keywords": ["laravel", "vultr", "api", "cloud"],
  "license": "MIT",
  "authors": [
    {
      "name": "Edison Costa",
      "email": "edison@keepcloud.io"
    }
  ],
  "require": {
    "php": ">=7.0.0",
    "ext-curl": "*",
    "ext-json": "*",
    "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "KeepCloud\\Vultr\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KeepCloud\\Vultr\\VultrServiceProvider"
      ],
      "aliases": {
        "Vultr": "KeepCloud\\Vultr\\Facades\\Vultr"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
