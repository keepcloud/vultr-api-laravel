{
  "name": "keepcloud/vultr-api-laravel",
  "description": "Laravel package for Vultr V2 Api",
  "keywords": ["laravel", "vultr", "api", "cloud"],
  "license": "MIT",
  "authors": [
    {
      "name": "Edison Costa",
      "email": "edison@keepcloud.io"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "KeepCloud\\Vultr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KeepCloud\\Vultr\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "extra": {
    "laravel": {
      "providers": [
        "KeepCloud\\Vultr\\VultrServiceProvider"
      ],
      "aliases": {
        "Vultr": "KeepCloud\\Vultr\\Facades\\Vultr"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
